{
  "model": "ins_enrolment",
  "access": [
    {
      "name": "own",
      "operations": [
        "read"
      ],
      "when": {
        "employee": "$hr.employee"
      }
    },
    {
      "name": "team",
      "operations": [
        "read"
      ],
      "when": {
        "employee": {
          "in": "$hr.subordinates"
        }
      }
    },
    {
      "name": "admin",
      "roles": [
        "ins_admin",
        "ins_reviewer",
        "via:self"
      ],
      "operations": [
        "read",
        "create",
        "write"
      ]
    }
  ]
}
