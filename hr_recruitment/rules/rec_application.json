{
  "model": "rec_application",
  "access": [
    {
      "name": "recruiters",
      "roles": [
        "recruiter",
        "recruit_manager"
      ],
      "operations": [
        "read",
        "create",
        "write"
      ]
    },
    {
      "name": "panel",
      "operations": [
        "read"
      ],
      "when": {
        "id": {
          "in": "$my_applications"
        }
      }
    },
    {
      "name": "referral",
      "roles": [
        "via:hr_referral"
      ],
      "operations": [
        "read",
        "create"
      ]
    }
  ],
  "fields": [
    {
      "fields": [
        "expected_salary"
      ],
      "read_roles": [
        "recruiter",
        "recruit_manager"
      ]
    },
    {
      "fields": [
        "notes"
      ],
      "read_roles": [
        "recruiter",
        "recruit_manager"
      ]
    }
  ]
}
