{
  "model": "rec_interview",
  "access": [
    {
      "name": "recruiters",
      "roles": [
        "recruiter",
        "recruit_manager"
      ],
      "operations": [
        "read",
        "create",
        "write"
      ]
    },
    {
      "name": "panel",
      "operations": [
        "read"
      ],
      "when": {
        "id": {
          "in": "$my_interviews"
        }
      }
    }
  ]
}
