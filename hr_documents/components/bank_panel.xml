<component name="bank_panel">
  <group cols="1">
    <modal title="Add bank account" label="Add account">
      <view type="form" function="add_bank_account" submit="Add" success="Account added">
        <field name="account_name" label="Account name" required="true"/>
        <field name="account_no" label="Account number" required="true"/>
        <field name="bank" label="Bank" required="true" fieldType="many2one"
               source="list_banks" optionLabel="name" entity="banks"/>
        <field name="branch" label="Branch" fieldType="many2one"
               source="list_bank_branches" optionLabel="name" entity="branches" depends="bank"/>
        <field name="share_percent" label="Share of net salary (%)" fieldType="float" required="true"/>
        <field name="iban" label="IBAN"/>
        <field name="swift" label="SWIFT"/>
        <field name="currency" label="Currency"/>
      </view>
    </modal>
    <view type="list" model="doc_bank" source="list_bank_accounts">
      <columns>
        <column field="account_name" label="Account"/>
        <column field="bank" label="Bank" fieldType="link" modelTarget="doc_bank_org"/>
        <column field="branch" label="Branch" fieldType="link" modelTarget="doc_bank_branch"/>
        <column field="account_no" label="Number"/>
        <column field="share_percent" label="Share %"/>
        <column field="is_active" label="Active" fieldType="boolean"/>
      </columns>
      <actions>
        <action name="remove" label="Remove" function="remove_bank_account"
                confirm="Remove this account?" danger="true"/>
      </actions>
      <empty title="No bank accounts" description="Accounts for the salary split appear here."/>
    </view>
  </group>
</component>
