{
  "model": "doc_identity",
  "access": [
    {
      "name": "own",
      "operations": [
        "read",
        "create",
        "write",
        "delete"
      ],
      "when": {
        "employee": "$hr.employee"
      }
    },
    {
      "name": "admin",
      "roles": [
        "documents_admin"
      ],
      "operations": [
        "read",
        "create",
        "write",
        "delete"
      ]
    }
  ]
}