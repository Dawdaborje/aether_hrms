{
  "model": "pay_approval_request",
  "access": [
    {
      "name": "staff",
      "operations": [
        "read"
      ],
      "roles": [
        "payroll_admin",
        "payroll_clerk",
        "payroll_approver",
        "payroll_finance"
      ]
    }
  ],
  "restrict": [
    {
      "name": "written_by_the_request_only",
      "operations": [
        "create",
        "write",
        "delete"
      ],
      "when": {
        "requested_from": ""
      }
    }
  ]
}
