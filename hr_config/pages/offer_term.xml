<page route="/hr/config/recruitment/offer-terms/{id}" title="Offer term" menu="false" roles="hr_recruitment.recruit_manager">
  <view type="form" source="get_offer_term" function="update_offer_term" submit="Save" success="Saved">
    <group title="Offer term" cols="2">
      <field name="name" label="Name" required="true"/>
      <field name="body" label="Text" fieldType="text"/>
      <field name="is_active" label="Active" fieldType="boolean"/>
    </group>
  </view>
</page>
