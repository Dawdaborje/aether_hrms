<page route="/hr/config/payroll/branches/{id}" title="Branch" menu="false" roles="hr_documents.documents_admin,hr.hr_manager">
  <view type="form" source="get_bank_branch" function="update_bank_branch" submit="Save" success="Saved">
    <group title="Branch" cols="2">
      <field name="bank" label="Bank" required="true" fieldType="many2one" source="list_all_banks" optionLabel="name" entity="banks"/>
      <field name="name" label="Name" required="true"/>
      <field name="code" label="Code"/>
      <field name="is_active" label="Active" fieldType="boolean"/>
    </group>
  </view>
</page>
