<page route="/hr/config/documents/banks/new" title="New bank" menu="false" roles="hr_documents.documents_admin,hr.hr_manager">
  <view type="form" function="create_bank" submit="Create" success="Created" redirect="/hr/config/documents/banks">
    <group title="Bank" cols="2">
      <field name="name" label="Name" required="true"/>
      <field name="code" label="Code"/>
      <field name="swift" label="SWIFT"/>
      <field name="is_active" label="Active" fieldType="boolean"/>
    </group>
  </view>
</page>
