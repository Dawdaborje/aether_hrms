<page route="/hr/config/hr" title="HR defaults" menu_group="General" icon="settings" sort="10" roles="hr.hr_manager">
  <view type="form" source="get_hr_setting" function="set_hr_setting" submit="Save" success="Saved">
    <group title="New hires" cols="2">
      <field name="default_probation_days" label="Default probation (days)" fieldType="integer"/>
      <field name="default_notice_days" label="Default notice (days)" fieldType="integer"/>
    </group>
    <group title="Alerts and reports" cols="2">
      <field name="probation_alert_days" label="Flag probation endings (days ahead)" fieldType="integer"/>
      <field name="retirement_age" label="Retirement age" fieldType="integer"/>
    </group>
  </view>
</page>
