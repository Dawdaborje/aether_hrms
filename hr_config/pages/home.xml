    <button label="Interviewer pools" href="/hr/config/recruitment/pools" variant="outline"/>
    <button label="Opening templates" href="/hr/config/recruitment/opening-templates" variant="outline"/>
    <button label="Offer terms" href="/hr/config/recruitment/offer-terms" variant="outline"/>
    <button label="Offer templates" href="/hr/config/recruitment/offer-templates" variant="outline"/>
  </group>
