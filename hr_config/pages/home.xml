  </group>
  <group title="Attendance" cols="2">
    <button label="Shifts" href="/hr/config/attendance/shifts" variant="outline"/>
    <button label="Rotations" href="/hr/config/attendance/rotations" variant="outline"/>
    <button label="Punch locations" href="/hr/config/attendance/locations" variant="outline"/>
    <button label="Overtime rules" href="/hr/config/attendance/overtime" variant="outline"/>
