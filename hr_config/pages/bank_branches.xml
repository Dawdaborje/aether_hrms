<page route="/hr/config/payroll/branches" title="Bank branches" menu_group="Payroll" icon="map-pin" sort="46" roles="hr_documents.documents_admin,hr.hr_manager">
  <view type="list" source="list_all_bank_branches" open="/hr/config/payroll/branches/{id}" create="/hr/config/payroll/branches/new" create_label="New">
    <columns>
      <column field="bank" label="Bank" fieldType="link" modelTarget="hr_documents.doc_bank_org"/>
      <column field="name" label="Branch"/>
      <column field="code" label="Code"/>
      <column field="is_active" label="Active" fieldType="boolean"/>
    </columns>
    <empty title="No branches" description="Branches are optional; add them when employees should pick a branch for a bank."/>
  </view>
</page>
