<page route="/hr/config/recruitment/offer-templates/{id}" title="Offer template" menu="false" roles="hr_recruitment.recruit_manager">
  <view type="form" source="get_offer_template" function="update_offer_template" submit="Save" success="Saved">
    <group title="Offer template" cols="2">
      <field name="name" label="Template name" required="true"/>
      <field name="intro" label="Introduction" fieldType="text"/>
      <field name="is_active" label="Active" fieldType="boolean"/>
    </group>
  </view>
</page>
