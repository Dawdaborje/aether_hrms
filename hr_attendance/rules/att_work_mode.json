{
  "model": "att_work_mode",
  "access": [
    {
      "name": "own",
      "operations": [
        "read"
      ],
      "when": {
        "employee": "$hr.employee"
      }
    },
    {
      "name": "admin",
      "roles": [
        "att_admin"
      ],
      "operations": [
        "read",
        "create",
        "write",
        "delete"
      ]
    },
    {
      "name": "others",
      "roles": [
        "via:*"
      ],
      "operations": [
        "read",
        "create",
        "write"
      ]
    }
  ]
}