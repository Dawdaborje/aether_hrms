{
  "model": "att_correction",
  "access": [
    {
      "name": "own",
      "operations": [
        "read",
        "create",
        "write"
      ],
      "when": {
        "employee": "$hr.employee"
      }
    },
    {
      "name": "team",
      "operations": [
        "read",
        "write"
      ],
      "when": {
        "employee": {
          "in": "$hr.subordinates"
        }
      }
    },
    {
      "name": "admin",
      "roles": [
        "att_admin"
      ],
      "operations": [
        "read",
        "create",
        "write",
        "delete"
      ]
    }
  ],
  "restrict": [
    {
      "name": "pending_only",
      "operations": [
        "write"
      ],
      "exempt_roles": [
        "att_admin"
      ],
      "when": {
        "status": "pending"
      }
    }
  ]
}
