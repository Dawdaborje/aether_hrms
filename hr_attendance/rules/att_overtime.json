{
  "model": "att_overtime",
  "access": [
    {
      "name": "own",
      "operations": [
        "read"
      ],
      "when": {
        "employee": "$hr.employee"
      }
    },
    {
      "name": "team",
      "operations": [
        "read"
      ],
      "when": {
        "employee": {
          "in": "$hr.subordinates"
        }
      }
    },
    {
      "name": "admin",
      "roles": [
        "att_admin"
      ],
      "operations": [
        "read"
      ]
    }
  ]
}