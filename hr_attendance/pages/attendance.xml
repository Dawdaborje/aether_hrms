<page route="/hr/attendance" title="Attendance" model="att_day">
  <view type="list" model="att_day" source="my_days" create="/hr/attendance/new" create_label="Punch">
    <columns>
      <column field="work_date" label="Date" fieldType="date"/>
      <column field="status" label="Status" fieldType="badge"/>
      <column field="worked_min" label="Worked (min)"/>
      <column field="late_min" label="Late (min)"/>
      <column field="review" label="Needs a look"/>
    </columns>
    <empty title="No days yet" description="Use Punch to start."/>
  </view>
</page>
