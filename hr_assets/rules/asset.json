{
  "model": "asset",
  "access": [
    {
      "name": "holder",
      "operations": [
        "read",
        "write"
      ],
      "when": {
        "holder": "$hr.employee"
      }
    },
    {
      "name": "admin",
      "roles": [
        "asset_admin"
      ],
      "operations": [
        "read",
        "create",
        "write"
      ]
    }
  ]
}