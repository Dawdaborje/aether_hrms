{
  "model": "trv_cost",
  "access": [
    {
      "name": "own",
      "operations": [
        "read",
        "create",
        "write",
        "delete"
      ],
      "when": {
        "employee": "$hr.employee"
      }
    },
    {
      "name": "team",
      "operations": [
        "read"
      ],
      "when": {
        "employee": {
          "in": "$hr.subordinates"
        }
      }
    },
    {
      "name": "admin",
      "roles": [
        "travel_admin"
      ],
      "operations": [
        "read",
        "create",
        "write"
      ]
    }
  ]
}