{
  "model": "employee_private",
  "access": [
    {
      "name": "own",
      "operations": [
        "read",
        "write"
      ],
      "when": {
        "employee": "$employee"
      }
    },
    {
      "name": "hr",
      "roles": [
        "hr_user",
        "hr_manager"
      ],
      "operations": [
        "read",
        "create",
        "write",
        "delete"
      ]
    }
  ]
}
