<page route="/hr/departments" title="Departments" model="department" menu_group="Employee" icon="building-2" sort="20" roles="hr_user,hr_manager">
  <view type="list" model="department" source="list_departments" open="/hr/departments/{id}"
        create="/hr/departments/new" create_label="New">
    <search/>
    <columns>
      <column field="name" label="Name"/>
      <column field="code" label="Code"/>
      <column field="is_active" label="Open" fieldType="boolean"/>
    </columns>
    <actions>
      <action name="close" label="Close" function="close_department" confirm="Close this department?" danger="true"/>
    </actions>
    <empty title="No departments yet" description="Use New to add one."/>
  </view>
</page>
