<page route="/hr/departments" title="Departments" model="department">
  <view type="list" model="department" source="list_departments" create="/hr/departments/new" create_label="New">
    <search/>
    <columns>
      <column field="name" label="Name"/>
      <column field="code" label="Code"/>
      <column field="is_active" label="Open" fieldType="boolean"/>
    </columns>
    <actions>
      <action name="close" label="Close" function="close_department" confirm="Close this department?" danger="true"/>
    </actions>
    <empty title="No departments yet" description="Use New to add one."/>
  </view>
</page>
