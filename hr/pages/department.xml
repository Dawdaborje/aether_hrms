<page route="/hr/departments/{id}" title="Department" model="department" menu="false" roles="hr_user,hr_manager">
  <view type="form" source="get_department" function="update_department" submit="Save" success="Saved">
    <group title="Overview" cols="2">
      <field name="name" label="Name" required="true"/>
      <field name="code" label="Code"/>
      <field name="parent" label="Part of" fieldType="many2one" source="list_departments" entity="departments"/>
      <field name="manager" label="Manager" fieldType="many2one" source="list_employees"
               optionLabel="display_name" entity="employees"/>
      <field name="cost_center" label="Cost centre"/>
      <field name="is_active" label="Open" fieldType="boolean"/>
    </group>
    <group title="Notes" cols="1">
      <field name="description" label="Description" fieldType="text"/>
    </group>
  </view>
</page>
