{
  "model": "ts_entry",
  "access": [
    {
      "name": "own",
      "operations": [
        "read"
      ],
      "when": {
        "employee": "$hr.employee"
      }
    },
    {
      "name": "admin",
      "roles": [
        "timesheet_admin"
      ],
      "operations": [
        "read",
        "create",
        "write"
      ]
    },
    {
      "name": "others",
      "roles": [
        "via:*"
      ],
      "operations": [
        "read",
        "create",
        "write"
      ]
    }
  ]
}